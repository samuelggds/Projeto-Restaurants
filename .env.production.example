# Infraestrutura/build SOMENTE. Este arquivo NAO deve ser env_file da API/worker.
# Copie tambem .env.production.runtime.example para .env.production.runtime.
APP_DOMAIN=app.seudominio.com
API_DOMAIN=api.seudominio.com
ACME_EMAIL=infra@seudominio.com
PRODUCTION_RUNTIME_ENV_FILE=.env.production.runtime

# Somente o banco e a etapa migrate recebem credenciais administrativas.
POSTGRES_DB=pizza_ai
POSTGRES_USER=pizza_owner
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
DIRECT_URL=postgresql://pizza_owner:SUBSTITUA_POR_UMA_SENHA_FORTE@db:5432/pizza_ai

# Escolha explicita: osrm (perfil selfhost-routing) ou geoapify.
# Para geoapify, coloque GEOAPIFY_API_KEY no arquivo de runtime, nao aqui.
ROUTING_REQUIRED=true
ROUTING_PROVIDER=osrm
GEOAPIFY_BASE_URL=https://api.geoapify.com
OSRM_BASE_URL=http://osrm:5000
GEOCODER_BASE_URL=http://nominatim:8080
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:26.8.0-debian
ROUTING_PBF_URL=https://download.geofabrik.de/south-america/brazil-latest.osm.pbf
ROUTING_REPLICATION_URL=https://download.geofabrik.de/south-america/brazil-updates/
NOMINATIM_UPDATE_MODE=continuous
NOMINATIM_PASSWORD=SUBSTITUA_POR_UMA_SENHA_INTERNA_FORTE
ROUTING_USER_AGENT=PizzaIADelivery/1.0 (infra@seudominio.com)
ROUTING_REQUEST_TIMEOUT_MS=4000
GEOCODER_REQUEST_TIMEOUT_MS=4000
ROUTING_CACHE_MAX_ENTRIES=5000

# Valores VITE_* sao publicos e incorporados ao build. Nunca coloque segredos.
VITE_SOCKET_PATH=/socket.io
VITE_API_TIMEOUT_MS=15000
VITE_MAP_TILE_URL=https://tiles.seudominio.com/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
VITE_GOOGLE_CLIENT_ID=
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
