# Dominios publicos. Crie os DNS antes de subir o gateway.
APP_DOMAIN=app.seudominio.com
API_DOMAIN=api.seudominio.com
ACME_EMAIL=infra@seudominio.com

# Banco interno (use valores longos e diferentes dos exemplos).
POSTGRES_DB=pizza_ia
POSTGRES_USER=pizza_app
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
DATABASE_URL=postgresql://pizza_app:SUBSTITUA_POR_UMA_SENHA_FORTE@db:5432/pizza_ia
DIRECT_URL=postgresql://pizza_app:SUBSTITUA_POR_UMA_SENHA_FORTE@db:5432/pizza_ia

# Segredos: gere valores independentes, por exemplo com `openssl rand -hex 48`.
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_96_CARACTERES
JWT_REFRESH_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO_COM_96_CARACTERES
JWT_MFA_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO_COM_96_CARACTERES
PAYMENT_PIN_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO_COM_96_CARACTERES
CREDENTIAL_ENCRYPTION_KEY=SUBSTITUA_POR_32_BYTES_ALEATORIOS_EM_BASE64
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=

# Conta unica do desenvolvedor da plataforma. Mantenha identidade e bootstrap
# habilitados em producao. Na primeira subida, preencha exatamente uma das duas
# fontes de senha abaixo; depois da criacao confirmada, remova o segredo.
SUPER_ADMIN_BOOTSTRAP_ENABLED=true
SUPER_ADMIN_BOOTSTRAP_NAME=Desenvolvedor da Plataforma
SUPER_ADMIN_BOOTSTRAP_EMAIL=desenvolvedor@seudominio.com
# Alternativa 1: segredo temporario injetado pelo gerenciador do deploy.
SUPER_ADMIN_BOOTSTRAP_PASSWORD=
# Alternativa 2 (preferida): caminho absoluto de um secret montado no container.
SUPER_ADMIN_BOOTSTRAP_PASSWORD_FILE=

NODE_ENV=production
PORT=3000
BACKEND_URL=https://api.seudominio.com
FRONTEND_URL=https://app.seudominio.com
CORS_ORIGINS=https://app.seudominio.com
SOCKET_CORS_ORIGINS=https://app.seudominio.com
REFRESH_COOKIE_SAME_SITE=lax
READINESS_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=3000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=50
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_REQUESTS=8
IMAGE_ENHANCEMENT_RATE_LIMIT_WINDOW_MS=900000
IMAGE_ENHANCEMENT_RATE_LIMIT_MAX_REQUESTS=5
LOGIN_LOCKOUT_AFTER_FAILURES=5
LOGIN_LOCKOUT_BASE_SECONDS=60
LOGIN_LOCKOUT_MAX_SECONDS=3600
MAX_JSON_BODY_SIZE=1mb
DELIVERY_LOCATION_RETENTION_DAYS=30
ALLOW_INSECURE_STRIPE_WEBHOOK=false
ALLOW_GLOBAL_PAYMENT_FALLBACK=false
ENABLE_TEST_PAYMENT_WEBHOOK=false
ENABLE_DESTRUCTIVE_CLEANUP=false
ALLOW_LEGACY_ACCESS_TOKENS=false
ALLOW_LOCAL_AUTH_CODE_LOGGING=false
ALLOW_UNTRUSTED_OAUTH_ENDPOINTS=false
JOBS_TIMEZONE=America/Sao_Paulo
TABLE_PAYMENT_EXPIRATION_INTERVAL_MS=60000
LOYALTY_REDEMPTION_EXPIRATION_CRON=*/5 * * * *
BILLING_MP_RECONCILE_CRON=*/5 * * * *

# Roteamento privado. O arquivo baixado deve ser salvo como
# routing-data/osrm/region.osm.pbf e processado com a mesma imagem abaixo.
ROUTING_REQUIRED=true
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:26.8.0-debian
ROUTING_PBF_URL=https://download.geofabrik.de/south-america/brazil-latest.osm.pbf
ROUTING_REPLICATION_URL=https://download.geofabrik.de/south-america/brazil-updates/
NOMINATIM_UPDATE_MODE=continuous
NOMINATIM_PASSWORD=SUBSTITUA_POR_UMA_SENHA_INTERNA_FORTE
ROUTING_USER_AGENT=PizzaIADelivery/1.0 (infra@seudominio.com)
ROUTING_REQUEST_TIMEOUT_MS=4000
GEOCODER_REQUEST_TIMEOUT_MS=4000
ROUTING_CACHE_MAX_ENTRIES=5000

# Frontend: API e Socket sao incorporados no build da imagem.
VITE_API_URL=https://api.seudominio.com
VITE_SOCKET_URL=https://api.seudominio.com
VITE_SOCKET_PATH=/socket.io
VITE_API_TIMEOUT_MS=15000
VITE_QR_BASE_URL=https://app.seudominio.com
# Em producao, use um provedor de tiles com SLA ou tiles proprios.
VITE_MAP_TILE_URL=https://tiles.seudominio.com/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
VITE_GOOGLE_CLIENT_ID=
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Observabilidade e e-mail. SMTP é obrigatório porque ADMIN e SUPER_ADMIN
# recebem o código MFA por e-mail em todo login.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
MFA_REQUIRED_ROLES=ADMIN,SUPER_ADMIN
SMTP_HOST=smtp.seudominio.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH_TYPE=basic
SMTP_USER=mailer@seudominio.com
SMTP_PASS=SUBSTITUA_POR_APP_PASSWORD_OU_SEGREDO_SMTP
ALERT_EMAIL_FROM=mailer@seudominio.com
ALERT_EMAIL_TO=
ALERT_PROVIDER=email
ALERT_TIMEOUT_MS=5000

# Opcional: habilita a melhoria de imagens de capa e banners pelo painel.
OPENAI_API_KEY=

# Pagamentos/OAuth opcionais. Preencha apenas os provedores utilizados.
GOOGLE_CLIENT_ID=
PLATFORM_MP_ACCESS_TOKEN=
MP_AUTO_RECONCILE_ENABLED=true
MP_AUTO_RECONCILE_MAX_INVOICES=50
MP_RECONCILE_TIMEOUT_MS=15000
MP_API_BASE_URL=https://api.mercadopago.com
MP_OAUTH_API_BASE_URL=https://api.mercadopago.com
MP_OAUTH_AUTH_URL=https://auth.mercadopago.com/authorization
# Webhook das mensalidades da plataforma.
MP_NOTIFICATION_URL=https://api.seudominio.com/billing/webhook/mercadopago
# Webhook dos pedidos dos restaurantes; o backend adiciona restaurantId por cobrança.
MP_ORDER_NOTIFICATION_URL=https://api.seudominio.com/orders/webhook/mercadopago
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAGBANK_EMAIL=
PAGBANK_TOKEN=
PAGBANK_ENV=production
PAGBANK_NOTIFICATION_URL=https://api.seudominio.com/orders/webhook/pagbank
ASAAS_API_KEY=
ASAAS_API_BASE_URL=https://api.asaas.com
