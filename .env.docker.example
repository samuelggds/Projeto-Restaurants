# Ambiente Docker local/staging. Copie para .env.docker e substitua todos os
# valores SUBSTITUA_* antes de mudar NODE_ENV para production.

# PostgreSQL
POSTGRES_DB=pizza_ia
POSTGRES_USER=pizza_app
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
DATABASE_URL=postgresql://pizza_app:SUBSTITUA_POR_UMA_SENHA_FORTE@db:5432/pizza_ia
DIRECT_URL=postgresql://pizza_app:SUBSTITUA_POR_UMA_SENHA_FORTE@db:5432/pizza_ia

# Backend
NODE_ENV=development
PORT=3000
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5174
SOCKET_CORS_ORIGINS=http://localhost:5174
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_96_CARACTERES
JWT_REFRESH_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO_COM_96_CARACTERES
JWT_MFA_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO_COM_96_CARACTERES
PAYMENT_PIN_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO_COM_96_CARACTERES
READINESS_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000
DELIVERY_LOCATION_RETENTION_DAYS=30
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=3000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=50
ALLOW_INSECURE_STRIPE_WEBHOOK=false
ALLOW_GLOBAL_PAYMENT_FALLBACK=false
ENABLE_TEST_PAYMENT_WEBHOOK=false
ENABLE_DESTRUCTIVE_CLEANUP=false

# Roteamento interno. Salve o mapa como routing-data/osrm/region.osm.pbf e
# processe-o conforme ROUTING_PRODUCTION.md antes de iniciar o OSRM.
ROUTING_REQUIRED=true
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:26.8.0-debian
ROUTING_DATASET_BASENAME=region
OSRM_BASE_URL=http://osrm:5000
GEOCODER_BASE_URL=http://nominatim:8080
ROUTING_USER_AGENT=PizzaIADelivery/1.0 (infra@seudominio.com)
ROUTING_PBF_URL=https://download.geofabrik.de/south-america/brazil/nordeste-latest.osm.pbf
ROUTING_REPLICATION_URL=https://download.geofabrik.de/south-america/brazil/nordeste-updates/
NOMINATIM_UPDATE_MODE=continuous
NOMINATIM_PASSWORD=SUBSTITUA_POR_UMA_SENHA_INTERNA_FORTE
ROUTING_REQUEST_TIMEOUT_MS=4000
GEOCODER_REQUEST_TIMEOUT_MS=4000
ROUTING_CACHE_MAX_ENTRIES=5000

# Frontend (variáveis VITE são incorporadas durante o build).
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000
VITE_SOCKET_PATH=/socket.io
VITE_API_TIMEOUT_MS=15000
VITE_QR_BASE_URL=http://localhost:5174
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
VITE_GOOGLE_CLIENT_ID=
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Integrações opcionais
GOOGLE_CLIENT_ID=
PLATFORM_MP_ACCESS_TOKEN=
MP_ACCESS_TOKEN=
MP_NOTIFICATION_URL=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
ALERT_PROVIDER=email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH_TYPE=basic
SMTP_USER=
SMTP_PASS=
SMTP_CLIENT_ID=
SMTP_CLIENT_SECRET=
SMTP_REFRESH_TOKEN=
SMTP_ACCESS_TOKEN=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
