# Compose / Postgres
POSTGRES_DB=pizza_ia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend runtime
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@db:5432/pizza_ia
DIRECT_URL=postgresql://postgres:postgres@db:5432/pizza_ia
JWT_SECRET=change_me
CORS_ORIGINS=http://localhost:5174
SOCKET_CORS_ORIGINS=http://localhost:5174
FRONTEND_URL=http://localhost:5174
GOOGLE_CLIENT_ID=
# Roteamento interno: use com docker-compose.routing.yml em producao.
OSRM_BASE_URL=http://osrm:5000
GEOCODER_BASE_URL=http://nominatim:8080
ROUTING_USER_AGENT=PizzaIADelivery/1.0 (suporte@seudominio.com)
ROUTING_PBF_URL=https://download.geofabrik.de/south-america/brazil/nordeste-latest.osm.pbf
MP_ACCESS_TOKEN=
MP_NOTIFICATION_URL=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
ALERT_PROVIDER=email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH_TYPE=basic
SMTP_USER=
SMTP_PASS=
SMTP_CLIENT_ID=
SMTP_CLIENT_SECRET=
SMTP_REFRESH_TOKEN=
SMTP_ACCESS_TOKEN=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Frontend build args
VITE_API_URL=http://localhost:3000
VITE_GOOGLE_CLIENT_ID=
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
