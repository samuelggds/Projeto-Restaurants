{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --maxWorkers=1",
    "test:coverage": "vitest run --coverage --maxWorkers=1",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test e2e/password-policy.spec.ts e2e/system-availability.spec.ts e2e/table-qr-role-flow.spec.ts e2e/customer-contextual-login.spec.ts e2e/product-customization.spec.ts e2e/kitchen-order-customizations.spec.ts e2e/waiter-operations.spec.ts e2e/attendant-operations.spec.ts e2e/courier-operations.spec.ts e2e/promotions-loyalty.spec.ts e2e/super-admin-platform.spec.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@sentry/react": "^10.63.0",
    "axios": "^1.18.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-leaflet": "^5.0.0",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.0",
    "react-toastify": "^11.1.0",
    "socket.io-client": "^4.8.3",
    "styled-components": "^6.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.0.12",
    "vitest": "^4.0.0"
  }
}
