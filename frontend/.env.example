VITE_API_URL=https://api.seudominio.com
# Opcional: URL base do frontend usada no QR das mesas (ex.: http://192.168.1.144:5173).
# Se nao definido, tenta usar o origin atual e, em localhost, usa o host da VITE_API_URL.
VITE_QR_BASE_URL=
# Opcional: se definido, o frontend usa este client id diretamente.
# Caso nao exista, ele busca o valor em GET /auth/google/client-id no backend.
VITE_GOOGLE_CLIENT_ID=seu_client_id_google.apps.googleusercontent.com

# Monitoring
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
