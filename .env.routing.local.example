# Copie para .env.routing.local antes de iniciar os serviços locais de rota.
# O recorte Nordeste atende AL, BA, CE, MA, PB, PE, PI, RN e SE.
ROUTING_PBF_URL=https://download.geofabrik.de/south-america/brazil/nordeste-latest.osm.pbf
ROUTING_REPLICATION_URL=https://download.geofabrik.de/south-america/brazil/nordeste-updates/
ROUTING_DATASET_BASENAME=region
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:26.8.0-debian
NOMINATIM_UPDATE_MODE=none
OSRM_HOST_PORT=5000
NOMINATIM_HOST_PORT=8080
