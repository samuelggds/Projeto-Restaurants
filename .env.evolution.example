# GastroNexa + Evolution API (self-hosted)
# Copie apenas os valores necessários para .env.production. Nunca versione segredos reais.

# Ativa o provider temporário do WhatsApp no worker/backend.
CUSTOMER_NOTIFICATION_PROVIDER=evolution

# Chave global da Evolution API. Gere um segredo aleatório forte.
# Ex.: openssl rand -hex 32
EVOLUTION_API_KEY=replace_with_random_64_hex_chars

# Senha do PostgreSQL exclusivo da Evolution API.
# Ex.: openssl rand -base64 32
EVOLUTION_DB_PASSWORD=replace_with_strong_database_password

# O backend usa http://evolution-api:8080 pela rede Docker interna definida
# em docker-compose.evolution.yml. Não exponha a porta 8080 publicamente.
