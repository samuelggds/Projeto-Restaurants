[Unit]
Description=GastroNexa encrypted offsite database backup
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/gastronexa/backup.env
WorkingDirectory=/opt/gastronexa
ExecStart=/bin/bash /opt/gastronexa/scripts/backup-production.sh
UMask=0077
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gastronexa-backups
StateDirectory=gastronexa-backups
