{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://backend:3000/infrastructure/custom-domains/caddy-allow
	}
}

{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy frontend:80
	# Only the isolated read-only help document may be embedded by the application itself.
	@helpPreview path /help-preview.html
	@application not path /help-preview.html
	header @helpPreview Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; form-action 'none'; script-src 'self'; frame-src 'none'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'none'; upgrade-insecure-requests"
	# The image enhancement response is a data URL. AdminPage converts it to a Blob
	# with fetch(data:...), so data: must be allowed by connect-src for the app only.
	# ViaCEP is used by the customer checkout to autofill delivery addresses from CEP.
	# Mercado Pago JS v2 hosts secure card fields in provider-controlled frames; known inline hashes and Mercado Libre telemetry host are allowlisted without enabling unsafe-inline.
	# Google Maps JavaScript API is loaded lazily only on the customer tracking route.
	# The browser receives only provider tokens; full card number and CVV stay outside GastroNexa.
	header @application Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-A9jGnUIc16GaqHCOULTuojGr83hLITWC0k/aRTF/k1o=' 'sha256-jScCZLu0SadLFc4DoxXZPwUjNQGwU92I1+SMbW1n2Uk=' 'sha256-wwP5jNOjC64B5S85JsNvBy023Uf8dFD+I/Zg9MGPiDc=' 'sha256-YbJPKtzVNFfNAaJXmQ9fk+1BnAC1QR8xVDJ9Zr56qI=' https://accounts.google.com/gsi/client https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/ https://sdk.mercadopago.com https://www.mercadopago.com/v2/security.js https://maps.googleapis.com https://maps.gstatic.com; frame-src 'self' https://accounts.google.com/gsi/ https://www.google.com/recaptcha/ https://*.mercadopago.com https://*.mercadopago.com.br; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' data: https://{$API_DOMAIN} wss://{$API_DOMAIN} https://viacep.com.br https://*.sentry.io https://accounts.google.com/gsi/ https://www.google.com/recaptcha/ https://recaptchaenterprise.googleapis.com https://api.mercadopago.com https://api.pagar.me https://*.mercadopago.com https://*.mercadopago.com.br https://api.mercadolibre.com https://maps.googleapis.com https://maps.gstatic.com; worker-src 'self' blob:; upgrade-insecure-requests"
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

{$API_DOMAIN} {
	encode zstd gzip

	# Infrastructure-only endpoints are callable from the Docker network, never
	# through the public API hostname.
	@internalInfrastructure path /infrastructure/custom-domains/*
	handle @internalInfrastructure {
		respond 404
	}

	handle {
		reverse_proxy {
			dynamic a backend 3000 {
				refresh 5s
				versions ipv4
			}
			lb_policy round_robin
			fail_duration 10s
			max_fails 2
			unhealthy_status 503
			transport http {
				dial_timeout 3s
				# OpenAI image generation/editing can legitimately take longer than 30 seconds.
				# Keep this above the backend provider timeout (165s) and browser timeout (180s).
				response_header_timeout 210s
			}
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}


# Restaurant-owned domains are admitted only after SUPER_ADMIN activation.
# The On-Demand TLS "ask" endpoint rejects every hostname not present as ACTIVE
# in RestaurantCustomDomain with an eligible Premium/Gestao Total subscription.
https:// {
	tls {
		on_demand
	}

	# On-Demand TLS controls certificate issuance. This second check also blocks
	# a previously certified hostname immediately after SUPER_ADMIN deactivation,
	# restaurant blocking or loss of Premium/Gestao Total eligibility.
	forward_auth backend:3000 {
		uri /infrastructure/custom-domains/caddy-allow
	}

	# The infrastructure authorization endpoint is never exposed through a
	# restaurant-owned hostname either.
	@customInternalInfrastructure path /api/infrastructure/custom-domains/*
	handle @customInternalInfrastructure {
		respond 404
	}

	# Custom restaurant hosts use a same-origin API facade. The prefix is stripped
	# before forwarding because backend routes are mounted at /auth, /orders, etc.
	handle_path /api/* {
		reverse_proxy backend:3000
	}

	handle /socket.io/* {
		reverse_proxy backend:3000
	}

	handle {
		reverse_proxy frontend:80
	}

	@customApplication not path /api/* /socket.io/*
	header @customApplication Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-A9jGnUIc16GaqHCOULTuojGr83hLITWC0k/aRTF/k1o=' 'sha256-jScCZLu0SadLFc4DoxXZPwUjNQGwU92I1+SMbW1n2Uk=' 'sha256-wwP5jNOjC64B5S85JsNvBy023Uf8dFD+I/Zg9MGPiDc=' 'sha256-YbJPKtzVNFfNAaJXmQ9fk+1BnAC1QR8xVDJ9Zr56qI=' https://accounts.google.com/gsi/client https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/ https://sdk.mercadopago.com https://www.mercadopago.com/v2/security.js https://maps.googleapis.com https://maps.gstatic.com; frame-src 'self' https://accounts.google.com/gsi/ https://www.google.com/recaptcha/ https://*.mercadopago.com https://*.mercadopago.com.br; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' data: https://{$API_DOMAIN} wss://{$API_DOMAIN} https://viacep.com.br https://*.sentry.io https://accounts.google.com/gsi/ https://www.google.com/recaptcha/ https://recaptchaenterprise.googleapis.com https://api.mercadopago.com https://api.pagar.me https://*.mercadopago.com https://*.mercadopago.com.br https://api.mercadolibre.com https://maps.googleapis.com https://maps.gstatic.com; worker-src 'self' blob:; upgrade-insecure-requests"
	header {
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
