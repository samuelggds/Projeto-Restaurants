# WhatsApp temporário por restaurante via Z-API
# Não commite valores reais. Configure somente no ambiente do backend/worker.
CUSTOMER_NOTIFICATION_PROVIDER=zapi
ZAPI_BASE_URL=https://api.z-api.io

# Token de segurança da conta/instâncias Z-API, quando habilitado no painel.
ZAPI_CLIENT_TOKEN=

# Necessário apenas para o botão "Conectar WhatsApp" provisionar uma instância
# automaticamente para cada restaurante. Use o Partner Token de integração.
ZAPI_PARTNER_TOKEN=

# URL pública HTTPS do backend. O GastroNexa usa este domínio para registrar os
# webhooks individuais de cada instância.
BACKEND_URL=https://api.gastronexa.com.br

# Credencial usada pelo GastroNexa para criptografar tokens por tenant no banco.
# Deve ser a mesma CREDENTIAL_ENCRYPTION_KEY segura já usada em produção.
CREDENTIAL_ENCRYPTION_KEY=

# O ADMIN nunca precisa receber instanceId, token, Client-Token ou Partner Token.
# A tela mostra somente status da conexão e QR Code.
