# API/worker SOMENTE. Nunca adicione DIRECT_URL ou POSTGRES_PASSWORD neste arquivo.
# A role deve ser NOSUPERUSER/NOBYPASSRLS e nao possuir as tabelas.
DATABASE_URL=postgresql://pizza_runtime:SUBSTITUA_POR_OUTRA_SENHA_FORTE@db:5432/pizza_ai
NODE_ENV=production
PORT=3000
BACKEND_URL=https://api.seudominio.com
FRONTEND_URL=https://app.seudominio.com
CORS_ORIGINS=https://app.seudominio.com
SOCKET_CORS_ORIGINS=https://app.seudominio.com

# Gere segredos independentes. Nunca copie os placeholders para producao.
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_96_CARACTERES
JWT_REFRESH_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO_COM_96_CARACTERES
JWT_MFA_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO_COM_96_CARACTERES
PAYMENT_PIN_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO_COM_96_CARACTERES
CREDENTIAL_ENCRYPTION_KEY=SUBSTITUA_POR_32_BYTES_ALEATORIOS_EM_BASE64
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=

# Preencha uma fonte de senha apenas na primeira criacao; remova depois.
# PASSWORD_FILE exige um secret montado explicitamente no container da API.
SUPER_ADMIN_BOOTSTRAP_ENABLED=true
SUPER_ADMIN_BOOTSTRAP_NAME=Desenvolvedor da Plataforma
SUPER_ADMIN_BOOTSTRAP_EMAIL=desenvolvedor@seudominio.com
SUPER_ADMIN_BOOTSTRAP_PASSWORD=
SUPER_ADMIN_BOOTSTRAP_PASSWORD_FILE=
REFRESH_COOKIE_SAME_SITE=lax
READINESS_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=3000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=50
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_REQUESTS=8
IMAGE_ENHANCEMENT_RATE_LIMIT_WINDOW_MS=900000
IMAGE_ENHANCEMENT_RATE_LIMIT_MAX_REQUESTS=5
LOGIN_LOCKOUT_AFTER_FAILURES=5
LOGIN_LOCKOUT_BASE_SECONDS=60
LOGIN_LOCKOUT_MAX_SECONDS=3600
MAX_JSON_BODY_SIZE=1mb
DELIVERY_LOCATION_RETENTION_DAYS=30
ALLOW_INSECURE_STRIPE_WEBHOOK=false
ALLOW_GLOBAL_PAYMENT_FALLBACK=false
ENABLE_TEST_PAYMENT_WEBHOOK=false
ENABLE_DESTRUCTIVE_CLEANUP=false
ALLOW_LEGACY_ACCESS_TOKENS=false
ALLOW_LOCAL_AUTH_CODE_LOGGING=false
ALLOW_UNTRUSTED_OAUTH_ENDPOINTS=false
JOBS_TIMEZONE=America/Sao_Paulo
TABLE_PAYMENT_EXPIRATION_INTERVAL_MS=60000
LOYALTY_REDEMPTION_EXPIRATION_CRON=*/5 * * * *
BILLING_MP_RECONCILE_CRON=*/5 * * * *

# Necessaria somente quando ROUTING_PROVIDER=geoapify na infraestrutura.
GEOAPIFY_API_KEY=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
MFA_REQUIRED_ROLES=ADMIN,SUPER_ADMIN
SMTP_HOST=smtp.seudominio.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH_TYPE=basic
SMTP_USER=mailer@seudominio.com
SMTP_PASS=SUBSTITUA_POR_APP_PASSWORD_OU_SEGREDO_SMTP
ALERT_EMAIL_FROM=mailer@seudominio.com
ALERT_EMAIL_TO=
ALERT_PROVIDER=email
ALERT_TIMEOUT_MS=5000
OPENAI_API_KEY=

# Preencha apenas provedores utilizados. Demais opcoes de runtime podem ser
# mantidas aqui, desde que nao sejam credenciais de infraestrutura/migracao.
GOOGLE_CLIENT_ID=
PLATFORM_MP_ACCESS_TOKEN=
MP_AUTO_RECONCILE_ENABLED=true
MP_AUTO_RECONCILE_MAX_INVOICES=50
MP_RECONCILE_TIMEOUT_MS=15000
MP_API_BASE_URL=https://api.mercadopago.com
MP_OAUTH_API_BASE_URL=https://api.mercadopago.com
MP_OAUTH_AUTH_URL=https://auth.mercadopago.com/authorization
MP_NOTIFICATION_URL=https://api.seudominio.com/billing/webhook/mercadopago
MP_ORDER_NOTIFICATION_URL=https://api.seudominio.com/orders/webhook/mercadopago
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAGBANK_EMAIL=
PAGBANK_TOKEN=
PAGBANK_ENV=production
PAGBANK_NOTIFICATION_URL=https://api.seudominio.com/orders/webhook/pagbank
ASAAS_API_KEY=
ASAAS_API_BASE_URL=https://api.asaas.com
