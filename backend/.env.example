NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
BACKEND_URL=https://seu-backend.onrender.com
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me_with_another_strong_secret
JWT_MFA_SECRET=change_me_with_another_strong_secret
JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=14d
JWT_MFA_EXPIRES_IN=10m
# Obrigatorio para o login com Google. O frontend pode buscar este valor via
# GET /auth/google/client-id caso VITE_GOOGLE_CLIENT_ID nao esteja definido.
GOOGLE_CLIENT_ID=seu_client_id_google.apps.googleusercontent.com

# Billing / Mercado Pago
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
MP_NOTIFICATION_URL=https://seu-backend.onrender.com/billing/webhook/mercadopago
FRONTEND_URL=https://seu-frontend.onrender.com

# CORS (comma-separated)
CORS_ORIGINS=https://seu-frontend.onrender.com
SOCKET_CORS_ORIGINS=https://seu-frontend.onrender.com

# Stripe (cartao)
# Em producao, use chave live (sk_live_...) e webhook real.
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# PagBank / PagSeguro (opcional, preencha se for usar)
PAGBANK_EMAIL=
PAGBANK_TOKEN=
PAGBANK_ENV=production
PAGBANK_NOTIFICATION_URL=https://seu-backend.onrender.com/orders/webhook/pagbank

# Monitoring / Security
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
MAX_JSON_BODY_SIZE=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=50
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_REQUESTS=8
LOGIN_LOCKOUT_AFTER_FAILURES=5
LOGIN_LOCKOUT_BASE_SECONDS=60
LOGIN_LOCKOUT_MAX_SECONDS=3600
LOGIN_LOCKOUT_STATE_TTL_MS=86400000
MFA_REQUIRED_ROLES=ADMIN,SUPER_ADMIN
MFA_CODE_TTL_MIN=10
ALLOW_INSECURE_STRIPE_WEBHOOK=false
ALLOW_GLOBAL_PAYMENT_FALLBACK=false
# Opcoes: email, discord, slack, google_chat, generic
# Se ALERT_PROVIDER nao for informado, o backend tenta detectar automaticamente.
ALERT_PROVIDER=email
ALERT_WEBHOOK_URL=

# Alertas por e-mail (SMTP)
SMTP_HOST=smtp.seudominio.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP auth type: basic | oauth2
SMTP_AUTH_TYPE=basic
SMTP_USER=usuario_smtp
SMTP_PASS=senha_smtp
SMTP_CLIENT_ID=
SMTP_CLIENT_SECRET=
SMTP_REFRESH_TOKEN=
SMTP_ACCESS_TOKEN=
ALERT_EMAIL_FROM="Alerts Pizza IA <alerts@seudominio.com>"
ALERT_EMAIL_TO=voce@seudominio.com

# IA de suporte (opcional)
AI_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=700
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=700
OPENAI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MEMORY_TTL_MS=1800000
AI_CHAT_MEMORY_MAX_TURNS=12
AI_CHAT_MEMORY_MAX_CONVERSATIONS=1500
