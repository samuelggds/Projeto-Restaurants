NODE_ENV=production
OPS_DATABASE_ENV=production
OPS_API_ENV=production
# Hash seguro da identidade do banco (usuário/projeto, host, porta, database e schema).
OPS_DATABASE_FINGERPRINT_PRODUCTION=
PORT=3000
# Aplicacao: use a URL do pooler do Supabase em producao.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=10
# Gere com: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=replace_me_with_32_random_bytes_in_base64
# Preencha apenas durante a janela de rotação e remova após `credentials:rotate`.
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
# Prisma CLI/migrations: conexao direta, ou session pooler na porta 5432 quando
# o ambiente que executa migrations nao tiver suporte a IPv6.
DIRECT_URL=postgresql://postgres:PASSWORD@DIRECT_HOST:5432/postgres?sslmode=require
BACKEND_URL=https://seu-backend.onrender.com
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me_with_another_strong_secret
JWT_MFA_SECRET=change_me_with_another_strong_secret
PAYMENT_PIN_SECRET=change_me_with_another_strong_secret
# Bootstrap idempotente da unica conta SUPER_ADMIN. Na primeira subida, forneca
# exatamente uma fonte de senha; remova-a assim que a criacao for confirmada.
SUPER_ADMIN_BOOTSTRAP_ENABLED=true
SUPER_ADMIN_BOOTSTRAP_NAME=Desenvolvedor da Plataforma
SUPER_ADMIN_BOOTSTRAP_EMAIL=desenvolvedor@seudominio.com
# Segredo temporario do gerenciador do deploy (nao grave a senha neste arquivo).
SUPER_ADMIN_BOOTSTRAP_PASSWORD=
# Alternativa preferida: caminho absoluto de um secret montado no runtime.
SUPER_ADMIN_BOOTSTRAP_PASSWORD_FILE=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=14d
JWT_MFA_EXPIRES_IN=10m
# Migração temporária apenas fora de produção; mantenha false por padrão.
# Esta flag é deliberadamente ignorada quando NODE_ENV=production.
ALLOW_LEGACY_ACCESS_TOKENS=false
# Somente para mocks locais de OAuth; produção rejeita esta flag.
ALLOW_UNTRUSTED_OAUTH_ENDPOINTS=false
# Obrigatorio para o login com Google. O frontend pode buscar este valor via
# GET /auth/google/client-id caso VITE_GOOGLE_CLIENT_ID nao esteja definido.
GOOGLE_CLIENT_ID=seu_client_id_google.apps.googleusercontent.com
# Roteamento da taxa por distancia.
# Comece com geoapify para usar uma API gerenciada/free tier; troque apenas estas
# variaveis se futuramente migrar para OSRM + Nominatim proprios.
ROUTING_REQUIRED=true
ROUTING_PROVIDER=geoapify
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com
# Necessarios somente quando ROUTING_PROVIDER=osrm.
OSRM_BASE_URL=http://seu-osrm:5000
GEOCODER_BASE_URL=http://seu-nominatim:8080
ROUTING_USER_AGENT=PizzaIADelivery/1.0 (contato@seudominio.com)
ROUTING_REQUEST_TIMEOUT_MS=4000
GEOCODER_REQUEST_TIMEOUT_MS=4000
ROUTING_CACHE_MAX_ENTRIES=5000
READINESS_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000

# Billing / Mercado Pago da plataforma (conta do SUPER_ADMIN/dono do sistema)
# Esta credencial recebe exclusivamente as mensalidades dos restaurantes.
PLATFORM_MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# Compatibilidade temporária: MP_ACCESS_TOKEN ainda é aceito como fallback.
MP_ACCESS_TOKEN=
# Webhook exclusivo das mensalidades cobradas pela plataforma.
MP_NOTIFICATION_URL=https://seu-backend.onrender.com/billing/webhook/mercadopago
# Webhook exclusivo dos pedidos Pix/cartão dos restaurantes. O restaurantId é adicionado por cobrança.
MP_ORDER_NOTIFICATION_URL=https://seu-backend.onrender.com/orders/webhook/mercadopago
# Quantos dias antes do vencimento o QR Code fica disponível para o Admin.
BILLING_PIX_OPEN_DAYS_BEFORE_DUE=5
MP_AUTO_RECONCILE_ENABLED=true
MP_AUTO_RECONCILE_MAX_INVOICES=50
MP_RECONCILE_TIMEOUT_MS=15000
MP_API_BASE_URL=https://api.mercadopago.com
BILLING_MP_RECONCILE_CRON=*/5 * * * *
LOYALTY_REDEMPTION_EXPIRATION_CRON=*/5 * * * *
TABLE_PAYMENT_EXPIRATION_INTERVAL_MS=60000
JOBS_TIMEZONE=America/Sao_Paulo
MP_OAUTH_CLIENT_ID=APP_USR-xxxxxxxxxxxxxxxx
MP_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Opcional: por padrao usa /settings/mercado-pago/oauth/callback no BACKEND_URL
MP_OAUTH_REDIRECT_URI=
# Opcional: defaults seguros para auth/token
MP_OAUTH_AUTH_URL=https://auth.mercadopago.com/authorization
MP_OAUTH_API_BASE_URL=https://api.mercadopago.com
# Webhook de simulacao local. Mantenha desativado fora de testes controlados.
ENABLE_TEST_PAYMENT_WEBHOOK=false
TEST_PAYMENT_WEBHOOK_SECRET=
ENABLE_DESTRUCTIVE_CLEANUP=false
FRONTEND_URL=https://seu-frontend.onrender.com
REFRESH_COOKIE_SAME_SITE=none

# CORS (comma-separated)
CORS_ORIGINS=https://seu-frontend.onrender.com
SOCKET_CORS_ORIGINS=https://seu-frontend.onrender.com

# Stripe (cartao)
# Em producao, use chave live (sk_live_...) e webhook real.
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# PagBank / PagSeguro (opcional, preencha se for usar)
PAGBANK_EMAIL=
PAGBANK_TOKEN=
PAGBANK_ENV=production
PAGBANK_NOTIFICATION_URL=https://seu-backend.onrender.com/orders/webhook/pagbank
# Aplicacao da plataforma na API Connect PagBank
PAGBANK_CONNECT_CLIENT_ID=
PAGBANK_CONNECT_CLIENT_SECRET=
PAGBANK_CONNECT_PLATFORM_TOKEN=
# Opcional: por padrao usa /settings/pagbank/oauth/callback no BACKEND_URL
PAGBANK_CONNECT_REDIRECT_URI=
PAGBANK_CONNECT_AUTH_URL=https://connect.pagbank.com.br/oauth2/authorize
PAGBANK_CONNECT_API_URL=https://api.pagseguro.com

# Chave da conta raiz Asaas usada para criar subcontas dos restaurantes
ASAAS_API_KEY=
ASAAS_API_BASE_URL=https://api.asaas.com

# Monitoring / Security
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
MAX_JSON_BODY_SIZE=1mb
DELIVERY_LOCATION_RETENTION_DAYS=30
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=50
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_REQUESTS=8
IMAGE_ENHANCEMENT_RATE_LIMIT_WINDOW_MS=900000
IMAGE_ENHANCEMENT_RATE_LIMIT_MAX_REQUESTS=5
LOGIN_LOCKOUT_AFTER_FAILURES=5
LOGIN_LOCKOUT_BASE_SECONDS=60
LOGIN_LOCKOUT_MAX_SECONDS=3600
LOGIN_LOCKOUT_STATE_TTL_MS=86400000
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000
PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=5
REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000
REGISTRATION_RATE_LIMIT_MAX_REQUESTS=10
TABLE_PIN_RATE_LIMIT_WINDOW_MS=300000
TABLE_PIN_RATE_LIMIT_MAX_REQUESTS=10
TABLE_PIN_ASSISTANCE_RATE_LIMIT_WINDOW_MS=60000
TABLE_PIN_ASSISTANCE_RATE_LIMIT_MAX_REQUESTS=3
PAYMENT_PIN_RATE_LIMIT_WINDOW_MS=600000
PAYMENT_PIN_RATE_LIMIT_MAX_REQUESTS=8
PAYMENT_PIN_REQUEST_RATE_LIMIT_WINDOW_MS=60000
PAYMENT_PIN_REQUEST_RATE_LIMIT_MAX_REQUESTS=3
MFA_REQUIRED_ROLES=ADMIN,SUPER_ADMIN
ALLOW_LOCAL_AUTH_CODE_LOGGING=false
MFA_CODE_TTL_MIN=10
ALLOW_INSECURE_STRIPE_WEBHOOK=false
ALLOW_GLOBAL_PAYMENT_FALLBACK=false
# Opcoes: email, discord, slack, google_chat, generic
# Se ALERT_PROVIDER nao for informado, o backend tenta detectar automaticamente.
ALERT_PROVIDER=email
ALERT_TIMEOUT_MS=5000
ALERT_WEBHOOK_URL=

# E-mail para MFA de administradores (obrigatório em produção) e alertas
SMTP_HOST=smtp.seudominio.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP auth type: basic | oauth2
SMTP_AUTH_TYPE=basic
SMTP_USER=usuario_smtp.com
SMTP_PASS=senha_smtp
SMTP_CLIENT_ID=
SMTP_CLIENT_SECRET=
SMTP_REFRESH_TOKEN=
SMTP_ACCESS_TOKEN=
ALERT_EMAIL_FROM="Alerts Pizza IA <alerts@seudominio.com>"
ALERT_EMAIL_TO=voce@seudominio.com

# IA de suporte (opcional)
AI_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=700
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=700
OPENAI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MEMORY_TTL_MS=1800000
AI_CHAT_MEMORY_MAX_TURNS=12
AI_CHAT_MEMORY_MAX_CONVERSATIONS=1500
