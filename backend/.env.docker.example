NODE_ENV=production
OPS_DATABASE_ENV=production
OPS_API_ENV=production
OPS_DATABASE_FINGERPRINT_PRODUCTION=
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/pizza_ai
DIRECT_URL=postgresql://postgres:postgres@host.docker.internal:5432/pizza_ai
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me_with_another_strong_secret
JWT_MFA_SECRET=change_me_with_another_strong_secret
# Bootstrap idempotente da unica conta SUPER_ADMIN. Na primeira subida, forneca
# exatamente uma fonte de senha; remova-a assim que a criacao for confirmada.
SUPER_ADMIN_BOOTSTRAP_ENABLED=true
SUPER_ADMIN_BOOTSTRAP_NAME=Desenvolvedor da Plataforma
SUPER_ADMIN_BOOTSTRAP_EMAIL=desenvolvedor@seudominio.com
# Segredo temporario do gerenciador do deploy (nao grave a senha neste arquivo).
SUPER_ADMIN_BOOTSTRAP_PASSWORD=
# Alternativa preferida: caminho absoluto de um secret montado no container.
SUPER_ADMIN_BOOTSTRAP_PASSWORD_FILE=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=14d
JWT_MFA_EXPIRES_IN=10m
# Compatibilidade temporaria: nunca habilite em producao (a flag e ignorada la).
ALLOW_LEGACY_ACCESS_TOKENS=false
# Somente para mocks locais de OAuth; produção rejeita esta flag.
ALLOW_UNTRUSTED_OAUTH_ENDPOINTS=false
CORS_ORIGINS=http://localhost:5173
SOCKET_CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
REFRESH_COOKIE_SAME_SITE=lax
GOOGLE_CLIENT_ID=
MP_ACCESS_TOKEN=
# Webhook de billing da plataforma.
MP_NOTIFICATION_URL=
# Webhook de pedidos Pix/cartão; o backend adiciona restaurantId.
MP_ORDER_NOTIFICATION_URL=
MP_AUTO_RECONCILE_ENABLED=true
MP_AUTO_RECONCILE_MAX_INVOICES=50
MP_RECONCILE_TIMEOUT_MS=15000
MP_API_BASE_URL=https://api.mercadopago.com
BILLING_MP_RECONCILE_CRON=*/5 * * * *
LOYALTY_REDEMPTION_EXPIRATION_CRON=*/5 * * * *
TABLE_PAYMENT_EXPIRATION_INTERVAL_MS=60000
JOBS_TIMEZONE=America/Sao_Paulo
MP_OAUTH_CLIENT_ID=
MP_OAUTH_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=
MP_OAUTH_AUTH_URL=https://auth.mercadopago.com/authorization
MP_OAUTH_API_BASE_URL=https://api.mercadopago.com
PAGBANK_CONNECT_CLIENT_ID=
PAGBANK_CONNECT_CLIENT_SECRET=
PAGBANK_CONNECT_PLATFORM_TOKEN=
PAGBANK_CONNECT_REDIRECT_URI=
PAGBANK_CONNECT_AUTH_URL=https://connect.pagbank.com.br/oauth2/authorize
PAGBANK_CONNECT_API_URL=https://api.pagseguro.com
ASAAS_API_KEY=
ASAAS_API_BASE_URL=https://api.asaas.com
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=50
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_REQUESTS=8
IMAGE_ENHANCEMENT_RATE_LIMIT_WINDOW_MS=900000
IMAGE_ENHANCEMENT_RATE_LIMIT_MAX_REQUESTS=5
LOGIN_LOCKOUT_AFTER_FAILURES=5
LOGIN_LOCKOUT_BASE_SECONDS=60
LOGIN_LOCKOUT_MAX_SECONDS=3600
LOGIN_LOCKOUT_STATE_TTL_MS=86400000
MFA_REQUIRED_ROLES=ADMIN,SUPER_ADMIN
ALLOW_LOCAL_AUTH_CODE_LOGGING=false
MFA_CODE_TTL_MIN=10
ALLOW_INSECURE_STRIPE_WEBHOOK=false
ALLOW_GLOBAL_PAYMENT_FALLBACK=false
# Opcional: necessário para o botão "Melhorar com IA" das imagens da marca e banners.
OPENAI_API_KEY=
PEXELS_API_KEY=
# Opcional (mínimo 32 caracteres): por padrão, a seleção usa JWT_SECRET.
INGREDIENT_IMAGE_TOKEN_SECRET=
INGREDIENT_IMAGE_SEARCH_RATE_LIMIT_WINDOW_MS=900000
INGREDIENT_IMAGE_SEARCH_RATE_LIMIT_MAX_REQUESTS=20
ALERT_PROVIDER=email
ALERT_TIMEOUT_MS=5000
# Obrigatório em produção para entregar os códigos MFA de administradores.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH_TYPE=basic
SMTP_USER=
SMTP_PASS=
SMTP_CLIENT_ID=
SMTP_CLIENT_SECRET=
SMTP_REFRESH_TOKEN=
SMTP_ACCESS_TOKEN=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
