generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            Int                          @id @default(autoincrement())
  name                          String
  email                         String                       @unique
  password                      String
  address                       String?
  city                          String?
  complement                    String?
  district                      String?
  number                        String?
  state                         String?
  zipCode                       String?
  active                        Boolean                      @default(true)
  authVersion                   Int                          @default(0)
  createdAt                     DateTime                     @default(now())
  phone                         String?
  restaurantId                  Int?
  updatedAt                     DateTime                     @updatedAt
  lastLoginAt                   DateTime?
  /// O índice único parcial `User_single_super_admin_idx` (migration SQL) limita a plataforma a um SUPER_ADMIN.
  role                          UserRole                     @default(CLIENTE)
  subRole                       FuncionarioSubRole?
  cpf                           String?
  resetPasswordCodeExpiresAt    DateTime?
  resetPasswordCodeHash         String?
  resetPasswordFailedAttempts   Int                          @default(0)
  resetPasswordLockedUntil      DateTime?
  mustChangePassword            Boolean                      @default(false)
  mfaEnabled                    Boolean                      @default(false)
  avatar                        String?
  authMfaChallenge              AuthMfaChallenge?
  authRefreshSession            AuthRefreshSession?
  orders                        Order[]
  assignedDeliveries            Order[]                      @relation("CourierDeliveries")
  deliveryLocations             DeliveryLocation[]
  orderIssueThreads             OrderIssueThread[]
  closedTableSessions           TableSession[]               @relation("ClosedTableSessions")
  openedTableSessions           TableSession[]               @relation("OpenedTableSessions")
  closingRequestedTableSessions TableSession[]               @relation("ClosingRequestedTableSessions")
  forceClosedTableSessions      TableSession[]               @relation("ForceClosedTableSessions")
  tableParticipants             TableParticipant[]
  restaurant                    Restaurant?                  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supportChatMessages           SupportChatMessage[]
  productFavorites              ProductFavorite[]
  addresses                     UserAddress[]
  couponRedemptions             CouponRedemption[]
  assignedTableServiceCalls     TableServiceCall[]           @relation("AssignedTableServiceCalls")
  resolvedTableServiceCalls     TableServiceCall[]           @relation("ResolvedTableServiceCalls")
  confirmedTablePayments        TablePaymentIntent[]         @relation("ManualTablePaymentConfirmations")
  tablePaymentEvents            TablePaymentEvent[]          @relation("TablePaymentEventActor")
  requestedAsaasWithdrawals     AsaasWithdrawalRequest[]
  oauthAuthorizationStates      OAuthAuthorizationState[]
  paymentMethods                CustomerPaymentMethod[]
  requestedKitchenPrintJobs     KitchenPrintJob[]            @relation("KitchenPrintJobRequester")
  courierCompensationPolicies   CourierCompensationPolicy[]  @relation("CourierCompensationPolicyCourier")
  courierSettlements            CourierSettlement[]          @relation("CourierSettlementCourier")
  employeeCompensationPolicies  EmployeeCompensationPolicy[] @relation("EmployeeCompensationPolicyEmployee")
  employeeWorkEntries           EmployeeWorkEntry[]          @relation("EmployeeWorkEntryEmployee")
  employeeEarnings              EmployeeEarning[]            @relation("EmployeeEarningEmployee")
  employeeSettlements           EmployeeSettlement[]         @relation("EmployeeSettlementEmployee")
  employeeSettlementPayments    EmployeeSettlementPayment[]  @relation("EmployeeSettlementPaymentEmployee")
  tableWaiterAssignments        TableWaiterAssignment[]      @relation("TableWaiterAssignmentWaiter")

  @@unique([id, restaurantId])
}

/// Configuracao publica e operacional da plataforma. Segredos e politicas que
/// exigem restart continuam exclusivamente no ambiente de deploy.
model PlatformSettings {
  id                    Int      @id @default(1)
  platformName          String   @default("S&C Platform")
  platformDomain        String   @default("app.scplatform.com.br")
  supportEmail          String   @default("suporte@scplatform.com.br")
  primaryColor          String   @default("#E9530B")
  locale                String   @default("pt-BR")
  currency              String   @default("BRL")
  timezone              String   @default("America/Sao_Paulo")
  dateFormat            String   @default("dd/MM/yyyy")
  allowRestaurantSignup Boolean  @default(false)
  requireManualApproval Boolean  @default(true)
  defaultTrialDays      Int      @default(30)
  auditRetentionDays    Int      @default(180)
  maintenanceMode       Boolean  @default(false)
  maintenanceMessage    String   @default("Plataforma temporariamente em manutencao.")
  version               Int      @default(1)
  updatedByUserId       Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// Catalogo financeiro editavel pelo SUPER_ADMIN. O codigo do plano segue o
/// enum usado pelas assinaturas e os precos valem apenas para novas faturas.
model PlatformPlan {
  code            PlanType @id
  name            String
  description     String
  monthlyFee      Decimal  @db.Decimal(10, 2)
  trialDays       Int      @default(30)
  features        Json
  featured        Boolean  @default(false)
  active          Boolean  @default(true)
  version         Int      @default(1)
  updatedByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserAddress {
  id         Int      @id @default(autoincrement())
  userId     Int
  label      String
  address    String
  number     String
  district   String
  city       String
  state      String
  zipCode    String
  complement String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
}

model Restaurant {
  id                            Int                            @id @default(autoincrement())
  name                          String
  slug                          String                         @unique
  email                         String                         @unique
  phone                         String?
  whatsapp                      String?
  cnpj                          String?                        @unique
  logo                          String?
  coverImage                    String?
  description                   String?
  address                       String?
  addressNumber                 String?
  addressComplement             String?
  addressDistrict               String?
  city                          String?
  state                         String?
  zipCode                       String?
  openingHours                  String?
  active                        Boolean                        @default(true)
  accessBlockReason             RestaurantAccessBlockReason    @default(NONE)
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  banners                       Banner[]
  categories                    Category[]
  coupons                       Coupon[]
  invoices                      Invoice[]
  orders                        Order[]
  products                      Product[]
  productDiscounts              ProductDiscount[]
  ingredients                   Ingredient[]
  productOptionGroups           ProductOptionGroup[]
  productOptions                ProductOption[]
  productCompositionItems       ProductCompositionItem[]
  productPortionConfigurations  ProductPortionConfiguration[]
  productConfigurationTemplates ProductConfigurationTemplate[]
  ratings                       ProductRating[]
  settings                      RestaurantSettings?
  supportChatMessages           SupportChatMessage[]
  subscription                  Subscription?
  tables                        Table[]
  users                         User[]
  orderIssueThreads             OrderIssueThread[]
  couponRedemptions             CouponRedemption[]
  tableServiceCalls             TableServiceCall[]
  tableSessions                 TableSession[]
  tableParticipants             TableParticipant[]
  tableBillItems                TableBillItem[]
  tablePaymentIntents           TablePaymentIntent[]
  tablePaymentEvents            TablePaymentEvent[]
  asaasWithdrawals              AsaasWithdrawalRequest[]
  oauthAuthorizationStates      OAuthAuthorizationState[]
  tableAccountSettings          TableAccountSettings?
  deliveryFeeRanges             DeliveryFeeRange[]
  customerPaymentMethods        CustomerPaymentMethod[]
  printerSettings               RestaurantPrinterSettings?
  printerAgentDevices           PrinterAgentDevice[]
  kitchenPrintJobs              KitchenPrintJob[]
  courierCompensationPolicies   CourierCompensationPolicy[]
  courierCompensationRanges     CourierCompensationRange[]
  courierSettlements            CourierSettlement[]
  courierSettlementItems        CourierSettlementItem[]
  employeeCompensationPolicies  EmployeeCompensationPolicy[]
  employeeWorkEntries           EmployeeWorkEntry[]
  employeeEarnings              EmployeeEarning[]
  employeeSettlements           EmployeeSettlement[]
  employeeSettlementItems       EmployeeSettlementItem[]
  employeeSettlementPayments    EmployeeSettlementPayment[]
  tableWaiterAssignments        TableWaiterAssignment[]
}

model RestaurantPrinterSettings {
  id               Int                     @id @default(autoincrement())
  restaurantId     Int                     @unique
  enabled          Boolean                 @default(false)
  autoPrintEnabled Boolean                 @default(false)
  autoPrintTrigger PrinterAutoPrintTrigger @default(NEW_ORDER)
  paperWidth       PrinterPaperWidth       @default(MM80)
  copies           Int                     @default(1)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  restaurant       Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, enabled, autoPrintEnabled])
}

/// Credencial de bootstrap do agente local. Esta tabela fica deliberadamente
/// fora do RLS porque o tenant ainda precisa ser descoberto a partir do
/// publicId + segredo antes de abrir o contexto tenant. Somente hash é salvo.
model PrinterAgentDevice {
  id           Int               @id @default(autoincrement())
  publicId     String            @unique @default(uuid())
  restaurantId Int
  name         String
  active       Boolean           @default(true)
  tokenHash    String
  printerName  String?
  lastSeenAt   DateTime?
  appVersion   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  claimedJobs  KitchenPrintJob[]

  @@unique([id, restaurantId])
  @@index([restaurantId, active, lastSeenAt])
}

model KitchenPrintJob {
  id                Int                      @id @default(autoincrement())
  publicId          String                   @unique @default(uuid())
  restaurantId      Int
  orderId           Int?
  type              KitchenPrintJobType
  source            KitchenPrintJobSource
  trigger           PrinterAutoPrintTrigger?
  status            KitchenPrintJobStatus    @default(PENDING)
  payloadVersion    Int                      @default(1)
  payload           Json
  paperWidth        PrinterPaperWidth
  copies            Int                      @default(1)
  attempts          Int                      @default(0)
  availableAt       DateTime                 @default(now())
  claimedAt         DateTime?
  leaseExpiresAt    DateTime?
  claimedByDeviceId Int?
  printedAt         DateTime?
  lastError         String?                  @db.VarChar(1000)
  deduplicationKey  String                   @unique @db.VarChar(191)
  requestedByUserId Int?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  restaurant        Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order             Order?                   @relation(fields: [orderId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  claimedByDevice   PrinterAgentDevice?      @relation(fields: [claimedByDeviceId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  requestedByUser   User?                    @relation("KitchenPrintJobRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, status, availableAt, createdAt])
  @@index([restaurantId, orderId, createdAt])
  @@index([claimedByDeviceId, leaseExpiresAt])
}

model CustomerPaymentMethod {
  id                      Int        @id @default(autoincrement())
  publicId                String     @unique @default(uuid())
  userId                  Int
  restaurantId            Int
  provider                String
  providerPaymentMethodId String
  providerCustomerId      String?
  brand                   String
  last4                   String
  expMonth                Int
  expYear                 Int
  holderName              String?
  isDefault               Boolean    @default(false)
  active                  Boolean    @default(true)
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  user                    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant              Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId, provider, providerPaymentMethodId])
  @@index([userId, restaurantId, active, isDefault])
  @@index([provider, providerCustomerId], map: "CustomerPaymentMethod_provider_customer_idx")
}

model SupportChatMessage {
  id                 Int                   @id @default(autoincrement())
  restaurantId       Int
  senderUserId       Int?
  senderRole         SupportChatSenderRole
  senderLabel        String
  message            String
  issueStatus        String?
  issueResponse      String?
  issueResponderName String?
  issueRespondedAt   DateTime?
  issueClosedAt      DateTime?
  sentAt             DateTime              @default(now())
  createdAt          DateTime              @default(now())
  restaurant         Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  senderUser         User?                 @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, sentAt])
  @@index([senderUserId, sentAt])
}

model Category {
  id           Int        @id @default(autoincrement())
  name         String
  description  String?
  image        String?
  active       Boolean    @default(true)
  restaurantId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     Product[]
}

model Product {
  id                   Int                          @id @default(autoincrement())
  name                 String
  description          String?
  image                String?
  price                Decimal                      @db.Decimal(10, 2)
  active               Boolean                      @default(true)
  featured             Boolean                      @default(false)
  preparationTime      Int?
  stock                Int?
  restaurantId         Int
  categoryId           Int
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  configurationVersion Int                          @default(1)
  items                OrderItem[]
  category             Category                     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurant           Restaurant                   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ratings              ProductRating[]
  favorites            ProductFavorite[]
  saleMode             ProductSaleMode              @default(BUILDABLE)
  ingredients          ProductIngredient[]
  optionGroups         ProductOptionGroup[]
  compositionItems     ProductCompositionItem[]
  portionConfiguration ProductPortionConfiguration?
  discount             ProductDiscount?

  @@unique([id, restaurantId])
}

model ProductDiscount {
  id           Int          @id @default(autoincrement())
  restaurantId Int
  productId    Int          @unique
  kind         DiscountKind
  value        Decimal      @db.Decimal(10, 2)
  label        String?
  active       Boolean      @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([restaurantId, active])
  @@index([restaurantId, startsAt, endsAt])
}

enum ProductSaleMode {
  COMPLETE
  BUILDABLE
}

enum DiscountKind {
  FIXED
  PERCENTAGE
}

model ProductIngredient {
  id        Int      @id @default(autoincrement())
  productId Int
  name      String
  price     Decimal  @default(0) @db.Decimal(10, 2)
  required  Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, active])
}

// Ingredient catalogue is isolated by restaurant. ProductIngredient stores the
// selection available for each product and can later reference this catalogue.
model Ingredient {
  id               Int                      @id @default(autoincrement())
  restaurantId     Int
  name             String
  category         String                   @default("Geral")
  price            Decimal                  @default(0) @db.Decimal(10, 2)
  image            String?
  active           Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  restaurant       Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  productOptions   ProductOption[]
  compositionItems ProductCompositionItem[]

  @@unique([restaurantId, name])
  @@unique([id, restaurantId])
  @@index([restaurantId, active])
  @@index([restaurantId, category, active])
}

enum ProductOptionSelectionType {
  SINGLE
  MULTIPLE
}

enum ProductOptionPricingMode {
  ADDITIVE
  ABSOLUTE
}

enum ProductPortionPricingStrategy {
  ADD
  HIGHEST
  AVERAGE
  PROPORTIONAL
  FIXED
}

model ProductOptionGroup {
  id                    Int                           @id @default(autoincrement())
  restaurantId          Int
  productId             Int
  name                  String
  description           String?
  required              Boolean                       @default(false)
  selectionType         ProductOptionSelectionType    @default(SINGLE)
  minSelections         Int                           @default(0)
  maxSelections         Int                           @default(1)
  position              Int                           @default(0)
  active                Boolean                       @default(true)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  restaurant            Restaurant                    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product               Product                       @relation(fields: [productId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  options               ProductOption[]
  portionConfigurations ProductPortionConfiguration[]

  @@unique([productId, name])
  @@unique([id, restaurantId])
  @@index([restaurantId, active])
  @@index([productId, position])
}

model ProductOption {
  id              Int                      @id @default(autoincrement())
  restaurantId    Int
  groupId         Int
  ingredientId    Int
  additionalPrice Decimal                  @default(0) @db.Decimal(10, 2)
  pricingMode     ProductOptionPricingMode @default(ADDITIVE)
  absolutePrice   Decimal?                 @db.Decimal(10, 2)
  allowQuantity   Boolean                  @default(false)
  minQuantity     Int                      @default(1)
  maxQuantity     Int                      @default(1)
  defaultQuantity Int                      @default(1)
  defaultSelected Boolean                  @default(false)
  locked          Boolean                  @default(false)
  active          Boolean                  @default(true)
  position        Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  restaurant      Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  group           ProductOptionGroup       @relation(fields: [groupId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  ingredient      Ingredient               @relation(fields: [ingredientId, restaurantId], references: [id, restaurantId], onDelete: Restrict)

  @@unique([groupId, ingredientId])
  @@unique([id, restaurantId])
  @@index([restaurantId, active])
  @@index([groupId, active, position])
  @@index([ingredientId])
}

model ProductCompositionItem {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  productId    Int
  ingredientId Int
  removable    Boolean    @default(false)
  active       Boolean    @default(true)
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId, restaurantId], references: [id, restaurantId], onDelete: Restrict)

  @@unique([productId, ingredientId])
  @@unique([id, restaurantId])
  @@index([restaurantId, active])
  @@index([productId, position])
}

model ProductPortionConfiguration {
  id                       Int                           @id @default(autoincrement())
  restaurantId             Int
  productId                Int
  optionGroupId            Int?
  enabled                  Boolean                       @default(true)
  minPortions              Int                           @default(1)
  maxPortions              Int                           @default(2)
  pricingStrategy          ProductPortionPricingStrategy @default(HIGHEST)
  allowPortionObservations Boolean                       @default(true)
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  restaurant               Restaurant                    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product                  Product                       @relation(fields: [productId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  optionGroup              ProductOptionGroup?           @relation(fields: [optionGroupId, restaurantId], references: [id, restaurantId], onDelete: Cascade)

  @@unique([productId, restaurantId])
  @@unique([id, restaurantId])
  @@index([restaurantId, enabled])
  @@index([optionGroupId])
}

model ProductConfigurationTemplate {
  id            Int        @id @default(autoincrement())
  restaurantId  Int
  name          String
  description   String?
  configuration Json
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, name])
  @@unique([id, restaurantId])
  @@index([restaurantId, active, createdAt])
}

model ProductFavorite {
  id           Int      @id @default(autoincrement())
  userId       Int
  productId    Int
  restaurantId Int
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, restaurantId])
  @@index([productId])
}

model ProductRating {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  productId    Int
  clientKey    String
  rating       Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, productId, clientKey])
  @@index([restaurantId, productId])
}

model Table {
  id            Int                @id @default(autoincrement())
  number        Int
  token         String             @unique
  active        Boolean            @default(true)
  restaurantId  Int
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  orders        Order[]
  restaurant    Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableSessions TableSession[]
  serviceCalls  TableServiceCall[]

  @@unique([restaurantId, number])
  @@unique([id, restaurantId])
}

model TableSession {
  id                   Int                      @id @default(autoincrement())
  publicId             String                   @unique @default(uuid())
  restaurantId         Int
  tableId              Int
  pinHash              String
  sessionToken         String                   @unique
  status               TableSessionStatus       @default(OPEN)
  openedById           Int
  closingRequestedById Int?
  closedById           Int?
  forceClosedById      Int?
  openedAt             DateTime                 @default(now())
  closingRequestedAt   DateTime?
  closedAt             DateTime?
  expiresAt            DateTime?
  forcedClosed         Boolean                  @default(false)
  forceCloseReason     String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  closedBy             User?                    @relation("ClosedTableSessions", fields: [closedById], references: [id], onDelete: SetNull)
  closingRequestedBy   User?                    @relation("ClosingRequestedTableSessions", fields: [closingRequestedById], references: [id], onDelete: SetNull)
  forceClosedBy        User?                    @relation("ForceClosedTableSessions", fields: [forceClosedById], references: [id], onDelete: SetNull)
  openedBy             User                     @relation("OpenedTableSessions", fields: [openedById], references: [id])
  restaurant           Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table                Table                    @relation(fields: [tableId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  serviceCalls         TableServiceCall[]
  participants         TableParticipant[]
  orders               Order[]
  billItems            TableBillItem[]
  paymentIntents       TablePaymentIntent[]
  paymentAllocations   TablePaymentAllocation[]
  paymentEvents        TablePaymentEvent[]
  waiterAssignments    TableWaiterAssignment[]
  employeeEarnings     EmployeeEarning[]

  @@unique([id, restaurantId])
  @@index([restaurantId, status, openedAt])
  @@index([tableId, status])
}

model TableParticipant {
  id             Int                    @id @default(autoincrement())
  publicId       String                 @unique @default(uuid())
  restaurantId   Int
  tableSessionId Int
  userId         Int?
  displayName    String?
  guestTokenHash String?                @unique
  tokenExpiresAt DateTime?
  status         TableParticipantStatus @default(ACTIVE)
  joinedAt       DateTime               @default(now())
  leftAt         DateTime?
  revokedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  restaurant     Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableSession   TableSession           @relation(fields: [tableSessionId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  user           User?                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  orders         Order[]
  orderItems     OrderItem[]
  billItems      TableBillItem[]
  paymentIntents TablePaymentIntent[]

  @@unique([tableSessionId, userId])
  @@unique([id, tableSessionId, restaurantId])
  @@index([restaurantId, tableSessionId, status])
  @@index([userId, status])
}

model TableServiceCall {
  id             Int                    @id @default(autoincrement())
  restaurantId   Int
  tableId        Int
  tableSessionId Int
  type           TableServiceCallType
  status         TableServiceCallStatus @default(WAITING)
  assignedToId   Int?
  resolvedById   Int?
  requestedAt    DateTime               @default(now())
  assignedAt     DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  restaurant     Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table          Table                  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableSession   TableSession           @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  assignedTo     User?                  @relation("AssignedTableServiceCalls", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy     User?                  @relation("ResolvedTableServiceCalls", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([restaurantId, status, requestedAt])
  @@index([tableId, status])
