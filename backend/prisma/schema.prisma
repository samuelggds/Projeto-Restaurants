model EmployeeSettlementItem {
  id                  Int                      @id @default(autoincrement())
  publicId            String                   @unique @default(uuid())
  restaurantId        Int
  settlementId        Int
  earningId           Int
  typeSnapshot        EmployeeEarningType
  directionSnapshot   EmployeeEarningDirection
  amountCentsSnapshot BigInt
  active              Boolean                  @default(true)
  releasedAt          DateTime?
  createdAt           DateTime                 @default(now())
  restaurant          Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  settlement          EmployeeSettlement       @relation(fields: [settlementId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  earning             EmployeeEarning          @relation(fields: [earningId, restaurantId], references: [id, restaurantId], onDelete: Restrict)

  @@unique([id, restaurantId])
  @@unique([settlementId, earningId])
  @@index([restaurantId, earningId, active])
}

model EmployeeSettlementPayment {
  id                 Int                             @id @default(autoincrement())
  publicId           String                          @unique @default(uuid())
  restaurantId       Int
  settlementId       Int
  employeeId         Int
  amountCents        BigInt
  method             EmployeeSettlementPaymentMethod
  reference          String?                         @db.VarChar(191)
  notes              String?                         @db.VarChar(500)
  status             EmployeeSettlementPaymentStatus @default(ACTIVE)
  idempotencyKeyHash String                          @db.VarChar(64)
  requestFingerprint String                          @db.VarChar(64)
  registeredById     Int
  registeredAt       DateTime                        @default(now())
  reversedAt         DateTime?
  reversedById       Int?
  reverseReason      String?                         @db.VarChar(500)
  version            Int                             @default(1)
  restaurant         Restaurant                      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  settlement         EmployeeSettlement              @relation(fields: [settlementId, restaurantId, employeeId], references: [id, restaurantId, employeeId], onDelete: Restrict)
  employee           User                            @relation("EmployeeSettlementPaymentEmployee", fields: [employeeId, restaurantId], references: [id, restaurantId], onDelete: Restrict)

  @@unique([id, restaurantId])
  @@unique([restaurantId, idempotencyKeyHash])
  @@index([restaurantId, settlementId, status, registeredAt])
}

model DeliveryFeeRange {
  id            Int      @id @default(autoincrement())
  restaurantId  Int
  maxDistanceKm Decimal  @db.Decimal(6, 2)
  fee           Decimal  @db.Decimal(10, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, maxDistanceKm])
  @@index([restaurantId, active, maxDistanceKm])
}

model AsaasWithdrawalRequest {
  id                 Int        @id @default(autoincrement())
  publicId           String     @unique @default(uuid())
  restaurantId       Int
  requestedByUserId  Int
  value              Decimal    @db.Decimal(12, 2)
  pixKeyHash         String
  pixKeyLastFour     String?
  description        String?
  status             String     @default("REQUESTED")
  providerTransferId String?    @unique
  providerStatus     String?
  expiresAt          DateTime
  validatedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  requestedBy        User       @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([restaurantId, status, createdAt])
  @@index([status, expiresAt])
}

model DeliveryLocation {
  id         BigInt   @id @default(autoincrement())
  orderId    Int
  courierId  Int
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  heading    Float?
  speed      Float?
  accuracy   Float?
  recordedAt DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier    User     @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([orderId, recordedAt])
  @@index([courierId, recordedAt])
  @@index([recordedAt])
}

model Banner {
  id           Int        @id @default(autoincrement())
  title        String
  highlight    String?
  description  String?
  buttonLabel  String?    @default("Ver cardápio")
  image        String
  active       Boolean    @default(true)
  position     Int        @default(0)
  restaurantId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, active, position, id])
}

model Coupon {
  id                       Int                @id @default(autoincrement())
  code                     String
  title                    String?
  description              String?
  discount                 Decimal            @db.Decimal(10, 2)
  discountType             DiscountKind       @default(FIXED)
  minimumSubtotal          Decimal            @default(0) @db.Decimal(10, 2)
  maxDiscount              Decimal?           @db.Decimal(10, 2)
  loyaltyPurchasesRequired Int                @default(1)
  perCustomerLimit         Int                @default(1)
  redemptionValidityDays   Int                @default(30)
  active                   Boolean            @default(true)
  expiration               DateTime?
  restaurantId             Int
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  restaurant               Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  redemptions              CouponRedemption[]
  orders                   Order[]

  @@unique([restaurantId, code])
  @@index([restaurantId, active, expiration])
}

model CouponRedemption {
  id           Int                    @id @default(autoincrement())
  restaurantId Int
  couponId     Int
  userId       Int
  cycle        Int
  status       CouponRedemptionStatus @default(CLAIMED)
  claimedAt    DateTime               @default(now())
  expiresAt    DateTime
  reservedAt   DateTime?
  usedAt       DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  restaurant   Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  coupon       Coupon                 @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Order?

  @@unique([restaurantId, couponId, userId, cycle])
  @@index([restaurantId, userId, status])
  @@index([restaurantId, userId, status, expiresAt])
  @@index([couponId, status])
  @@index([status, expiresAt])
}

model Subscription {
  id                          Int                @id @default(autoincrement())
  restaurantId                Int                @unique
  plan                        PlanType           @default(BASICO)
  status                      SubscriptionStatus @default(TESTE)
  trialEndsAt                 DateTime?
  currentPeriodStart          DateTime?
  currentPeriodEnd            DateTime?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  balanceDebt                 Decimal            @default(0) @db.Decimal(10, 2)
  planChangeLockedUntil       DateTime?
  planChangeInvoiceId         Int?
  scheduledPlan               PlanType?
  scheduledPlanEffectiveMonth Int?
  scheduledPlanEffectiveYear  Int?
  restaurant                  Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([status, trialEndsAt])
}

model Invoice {
  id                     Int           @id @default(autoincrement())
  restaurantId           Int
  month                  Int
  year                   Int
  monthlyFee             Decimal       @db.Decimal(10, 2)
  systemFees             Decimal       @db.Decimal(10, 2)
  total                  Decimal       @db.Decimal(10, 2)
  status                 InvoiceStatus @default(PENDENTE)
  createdAt              DateTime      @default(now())
  dueDate                DateTime
  paidAt                 DateTime?
  paymentLink            String?
  paymentExternalId      String?
  pixQrCode              String?
  pixQrCodeBase64        String?
  pixExpiresAt           DateTime?
  lastReconciledAt       DateTime?
  reconciliationAttempts Int           @default(0)
  nextReconciliationAt   DateTime      @default(now())
  restaurant             Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, month, year])
  @@index([status, dueDate])
  @@index([status, createdAt])
  @@index([status, nextReconciliationAt, id])
}

model AuthRefreshSession {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  jti       String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jti])
  @@index([expiresAt])
}

model LoginLockout {
  id              Int       @id @default(autoincrement())
  emailNormalized String    @unique
  failedAttempts  Int       @default(0)
  lockUntil       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([lockUntil])
}

model AuthMfaChallenge {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  codeHash       String
  failedAttempts Int      @default(0)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model OAuthAuthorizationState {
  id           Int        @id @default(autoincrement())
  provider     String
  userId       Int
  restaurantId Int
  authVersion  Int
  nonceHash    String     @unique
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([provider, userId])
  @@index([expiresAt])
  @@index([restaurantId, provider])
}

model ScheduledJobState {
  jobKey              String    @id @db.VarChar(191)
  ownerId             String?   @db.VarChar(191)
  leaseVersion        BigInt    @default(0)
  leaseExpiresAt      DateTime?
  nextRunAt           DateTime  @default(now())
  lastStartedAt       DateTime?
  lastCompletedAt     DateTime?
  lastFailedAt        DateTime?
  lastError           String?   @db.VarChar(2000)
  consecutiveFailures Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([nextRunAt, leaseExpiresAt])
  @@index([leaseExpiresAt])
  @@index([ownerId, leaseVersion])
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  userId         Int?
  userName       String?
  userRole       String?
  restaurantId   Int?
  restaurantName String?
  action         String
  resource       String?
  ipAddress      String?
  result         String   @default("SUCCESS")
  requestId      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([restaurantId, createdAt])
}

