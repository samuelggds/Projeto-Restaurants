generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         Int                  @id @default(autoincrement())
  name                       String
  email                      String               @unique
  password                   String
  address                    String?
  city                       String?
  complement                 String?
  district                   String?
  number                     String?
  state                      String?
  zipCode                    String?
  active                     Boolean              @default(true)
  createdAt                  DateTime             @default(now())
  phone                      String?
  restaurantId               Int?
  updatedAt                  DateTime             @updatedAt
  role                       UserRole             @default(CLIENTE)
  subRole                    FuncionarioSubRole?
  cpf                        String?
  resetPasswordCodeExpiresAt DateTime?
  resetPasswordCodeHash      String?
  mustChangePassword         Boolean              @default(false)
  avatar                     String?
  authMfaChallenge           AuthMfaChallenge?
  authRefreshSession         AuthRefreshSession?
  orders                     Order[]
  assignedDeliveries         Order[]              @relation("CourierDeliveries")
  deliveryLocations          DeliveryLocation[]
  orderIssueThreads          OrderIssueThread[]
  closedTableSessions        TableSession[]       @relation("ClosedTableSessions")
  openedTableSessions        TableSession[]       @relation("OpenedTableSessions")
  restaurant                 Restaurant?          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supportChatMessages        SupportChatMessage[]
}

model Restaurant {
  id                  Int                  @id @default(autoincrement())
  name                String
  slug                String               @unique
  email               String               @unique
  phone               String?
  whatsapp            String?
  cnpj                String?              @unique
  logo                String?
  coverImage          String?
  description         String?
  address             String?
  city                String?
  state               String?
  zipCode             String?
  openingHours        String?
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  banners             Banner[]
  categories          Category[]
  coupons             Coupon[]
  invoices            Invoice[]
  orders              Order[]
  products            Product[]
  ratings             ProductRating[]
  settings            RestaurantSettings?
  supportChatMessages SupportChatMessage[]
  subscription        Subscription?
  tables              Table[]
  users               User[]
  orderIssueThreads   OrderIssueThread[]
}

model SupportChatMessage {
  id           Int                   @id @default(autoincrement())
  restaurantId Int
  senderUserId Int?
  senderRole   SupportChatSenderRole
  senderLabel  String
  message      String
  sentAt       DateTime              @default(now())
  createdAt    DateTime              @default(now())
  restaurant   Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  senderUser   User?                 @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, sentAt])
  @@index([senderUserId, sentAt])
}

model Category {
  id           Int        @id @default(autoincrement())
  name         String
  description  String?
  image        String?
  active       Boolean    @default(true)
  restaurantId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     Product[]
}

model Product {
  id              Int             @id @default(autoincrement())
  name            String
  description     String?
  image           String?
  price           Decimal         @db.Decimal(10, 2)
  active          Boolean         @default(true)
  featured        Boolean         @default(false)
  preparationTime Int?
  stock           Int?
  restaurantId    Int
  categoryId      Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  items           OrderItem[]
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ratings         ProductRating[]
}

model ProductRating {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  productId    Int
  clientKey    String
  rating       Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, productId, clientKey])
  @@index([restaurantId, productId])
}

model Table {
  id            Int            @id @default(autoincrement())
  number        Int
  token         String         @unique
  active        Boolean        @default(true)
  restaurantId  Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        Order[]
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableSessions TableSession[]

  @@unique([restaurantId, number])
}

model TableSession {
  id           Int                @id @default(autoincrement())
  tableId      Int
  pinHash      String
  sessionToken String             @unique
  status       TableSessionStatus @default(OPEN)
  openedById   Int
  closedById   Int?
  openedAt     DateTime           @default(now())
  closedAt     DateTime?
  expiresAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  closedBy     User?              @relation("ClosedTableSessions", fields: [closedById], references: [id])
  openedBy     User               @relation("OpenedTableSessions", fields: [openedById], references: [id])
  table        Table              @relation(fields: [tableId], references: [id], onDelete: Cascade)
}

model Order {
  id                              Int               @id @default(autoincrement())
  total                           Decimal           @db.Decimal(10, 2)
  createdAt                       DateTime          @default(now())
  userId                          Int
  address                         String?
  city                            String?
  complement                      String?
  district                        String?
  number                          String?
  state                           String?
  zipCode                         String?
  observation                     String?
  paid                            Boolean           @default(false)
  paymentMethod                   PaymentMethod?
  payOnDelivery                   Boolean           @default(false)
  payOnDeliveryMethod             PaymentMethod?
  restaurantId                    Int
  tableId                         Int?
  type                            OrderType
  updatedAt                       DateTime          @updatedAt
  status                          OrderStatus       @default(PENDENTE)
  feeCollected                    Boolean           @default(false)
  systemFee                       Decimal           @default(0) @db.Decimal(10, 2)
  paymentProof                    String?
  paymentProofImage               String?
  paymentConfirmationPin          String?
  paymentConfirmationPinExpiresAt DateTime?
  paidAt                          DateTime?
  pixPaymentId                    String?
  cardCheckoutSessionId           String?
  assignedCourierId               Int?
  deliveryStartedAt               DateTime?
  deliveredAt                     DateTime?
  courierEarning                  Decimal           @default(0) @db.Decimal(10, 2)
  courierPaidAt                   DateTime?
  restaurant                      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table                           Table?            @relation(fields: [tableId], references: [id])
  user                            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedCourier                 User?             @relation("CourierDeliveries", fields: [assignedCourierId], references: [id], onDelete: SetNull)
  items                           OrderItem[]
  issueThread                     OrderIssueThread?
  deliveryLocations               DeliveryLocation[]

  @@index([restaurantId, status, assignedCourierId])
  @@index([assignedCourierId, deliveryStartedAt])
}

model OrderIssueThread {
  id             Int                 @id @default(autoincrement())
  orderId        Int                 @unique
  userId         Int
  restaurantId   Int
  customerName   String
  customerPhone  String?
  orderStatus    String
  orderType      String
  paymentMethod  String?
  total          Decimal             @db.Decimal(10, 2)
  orderCreatedAt DateTime
  addressLabel   String?
  itemsSummary   String[]            @default([])
  isResolved     Boolean             @default(false)
  resolvedAt     DateTime?
  resolvedByName String?
  openedAt       DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  messages       OrderIssueMessage[]
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant     Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, updatedAt])
  @@index([userId, updatedAt])
}

model OrderIssueMessage {
  id         Int                  @id @default(autoincrement())
  threadId   Int
  senderType OrderIssueSenderType
  senderName String
  message    String
  sentAt     DateTime             @default(now())
  thread     OrderIssueThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, sentAt])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  quantity    Int
  orderId     Int
  observation String?
  price       Decimal @db.Decimal(10, 2)
  productId   Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model RestaurantSettings {
  id                     Int        @id @default(autoincrement())
  restaurantId           Int        @unique

  // Operação de pedidos
  deliveryFee            Decimal    @default(0) @db.Decimal(10, 2)
  courierFeePerDelivery  Decimal    @default(0) @db.Decimal(10, 2)
  minimumOrder           Decimal    @default(0) @db.Decimal(10, 2)
  acceptsDelivery        Boolean    @default(true)
  acceptsPickup          Boolean    @default(true)
  averageDeliveryTime    String?
  acceptsPix             Boolean    @default(true)
  acceptsCard            Boolean    @default(true)

  // Aparência e presença digital
  slogan                 String?
  primaryColor           String     @default("#c95d3d")
  instagram              String?
  facebook               String?
  tiktok                 String?
  youtube                String?

  // Horários
  businessHours          Json?

  // WhatsApp
  whatsappEnabled            Boolean @default(false)
  whatsappDefaultMessage     String?
  receiveOrdersOnWhatsapp    Boolean @default(false)
  receiveStatusNotifications Boolean @default(false)

  // Pix e gateways
  pixKey                 String?
  pixProvider            String     @default("MERCADO_PAGO")
  cardGateway            String?
  gatewayMerchantId      String?

  // Dados financeiros / onboarding
  bankName               String?
  bankBranch             String?
  bankAccount            String?
  legalDocumentType      String?
  companyDocument        String?
  companyLegalName       String?
  companyTradeName       String?
  companyAddress         String?
  companyCnae            String?
  monthlyRevenue         Decimal?   @db.Decimal(12, 2)
  ownerFullName          String?
  ownerCpf               String?
  ownerBirthDate         DateTime?
  ownerEmail             String?
  ownerPhone             String?
  ownerAddress           String?
  bankCode               String?
  bankAccountType        String?
  bankHolderDocument     String?
  ownerDocumentFileUrl   String?
  bankProofFileUrl       String?
  companyContractFileUrl String?

  // Credenciais dos gateways
  mercadoPagoAccessToken String?
  picpayToken            String?
  asaasAccessToken       String?

  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  restaurant             Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model DeliveryLocation {
  id         BigInt   @id @default(autoincrement())
  orderId    Int
  courierId  Int
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  heading    Float?
  speed      Float?
  accuracy   Float?
  recordedAt DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier    User     @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([orderId, recordedAt])
  @@index([courierId, recordedAt])
}

model Banner {
  id           Int        @id @default(autoincrement())
  title        String
  image        String
  active       Boolean    @default(true)
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Coupon {
  id           Int        @id @default(autoincrement())
  code         String
  discount     Decimal    @db.Decimal(10, 2)
  active       Boolean    @default(true)
  expiration   DateTime?
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, code])
}

model Subscription {
  id                          Int                @id @default(autoincrement())
  restaurantId                Int                @unique
  plan                        PlanType           @default(BASICO)
  status                      SubscriptionStatus @default(TESTE)
  trialEndsAt                 DateTime?
  currentPeriodStart          DateTime?
  currentPeriodEnd            DateTime?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  balanceDebt                 Decimal            @default(0) @db.Decimal(10, 2)
  planChangeLockedUntil       DateTime?
  scheduledPlan               PlanType?
  scheduledPlanEffectiveMonth Int?
  scheduledPlanEffectiveYear  Int?
  restaurant                  Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Invoice {
  id           Int           @id @default(autoincrement())
  restaurantId Int
  month        Int
  year         Int
  monthlyFee   Decimal       @db.Decimal(10, 2)
  systemFees   Decimal       @db.Decimal(10, 2)
  total        Decimal       @db.Decimal(10, 2)
  status       InvoiceStatus @default(PENDENTE)
  createdAt    DateTime      @default(now())
  dueDate      DateTime
  paidAt       DateTime?
  paymentLink  String?
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, month, year])
}

model AuthRefreshSession {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  jti       String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jti])
  @@index([expiresAt])
}

model LoginLockout {
  id              Int       @id @default(autoincrement())
  emailNormalized String    @unique
  failedAttempts  Int       @default(0)
  lockUntil       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([lockUntil])
}

model AuthMfaChallenge {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  userId         Int?
  userName       String?
  userRole       String?
  restaurantId   Int?
  restaurantName String?
  action         String
  resource       String?
  ipAddress      String?
  result         String   @default("SUCCESS")
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FUNCIONARIO
  CLIENTE
  MOTOQUEIRO
}

enum FuncionarioSubRole {
  COZINHA
  GARCOM
}

enum OrderStatus {
  PENDENTE
  PREPARANDO
  PRONTO
  SAIU_PARA_ENTREGA
  ENTREGUE
  CANCELADO
}

enum OrderType {
  DELIVERY
  MESA
  RETIRADA
}

enum PaymentMethod {
  PIX
  CARTAO
  DINHEIRO
}

enum OrderIssueSenderType {
  CLIENT
  ADMIN
}

enum SupportChatSenderRole {
  ADMIN
  SUPER_ADMIN
}

enum PlanType {
  BASICO
  PROFISSIONAL
  PREMIUM
}

enum SubscriptionStatus {
  TESTE
  ATIVA
  EXPIRADA
  CANCELADA
}

enum TableSessionStatus {
  OPEN
  CLOSED
}

enum InvoiceStatus {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}
