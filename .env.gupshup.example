# WhatsApp via Gupshup
# Nunca commite a chave real. Configure estes valores no ambiente do backend/worker.
CUSTOMER_NOTIFICATION_PROVIDER=gupshup
GUPSHUP_API_KEY=
GUPSHUP_API_URL=https://api.gupshup.io/wa/api/v1/msg
GUPSHUP_TEMPLATE_API_URL=https://api.gupshup.io/wa/api/v1/template/msg
GUPSHUP_PROFILE_API_BASE_URL=https://api.gupshup.io

# Webhook de entrada: configure a Gupshup para enviar callbacks para
# https://SEU_BACKEND/api/webhooks/gupshup/inbound?token=SEU_TOKEN
# Use um valor longo e aleatório. Em produção o backend recusa o webhook se este token não existir.
WHATSAPP_WEBHOOK_TOKEN=

# Para um único app/número conectado:
GUPSHUP_APP_NAME=
GUPSHUP_APP_ID=
# Opcional no piloto de um único app: número de origem somente com dígitos.
GUPSHUP_SOURCE_NUMBER=

# Para vários restaurantes/números, use os mapas abaixo em vez dos fallbacks acima.
# As chaves são os números de origem em formato E.164 apenas com dígitos.
# O mesmo mapa também permite descobrir qual tenant recebeu uma mensagem de entrada pelo nome do app.
# Exemplo: {"5585999999999":"RestaurantA","5511988887777":"RestaurantB"}
GUPSHUP_APP_BY_SOURCE_JSON={}
# Exemplo: {"5585999999999":"uuid-app-a","5511988887777":"uuid-app-b"}
GUPSHUP_APP_ID_BY_SOURCE_JSON={}

# Mensagens automáticas iniciadas pela empresa devem usar templates aprovados fora
# da janela permitida pelo WhatsApp. Em produção, use "required" depois que todos
# os templates abaixo estiverem aprovados e cadastrados.
# prefer   = usa template quando existir e texto de sessão como fallback.
# required = eventos automáticos falham de forma segura se o template estiver ausente.
# disabled = força texto de sessão (use apenas quando souber que a janela permite).
GUPSHUP_AUTOMATIC_TEMPLATE_MODE=prefer

# A mensagem inicial configurada pelo ADMIN é diferente dos eventos abaixo:
# ela só é enviada depois que o cliente fala com o restaurante, portanto usa texto
# de sessão e o backend acrescenta automaticamente https://www.gastronexa.com.br/{slug}.

# IDs dos templates aprovados para um único app.
GUPSHUP_TEMPLATE_PAYMENT_CONFIRMED_ID=
GUPSHUP_TEMPLATE_ORDER_PENDING_ID=
GUPSHUP_TEMPLATE_ORDER_PREPARING_ID=
GUPSHUP_TEMPLATE_ORDER_READY_ID=
GUPSHUP_TEMPLATE_ORDER_OUT_FOR_DELIVERY_ID=
GUPSHUP_TEMPLATE_ORDER_DELIVERED_ID=
GUPSHUP_TEMPLATE_ORDER_CANCELLED_ID=

# Para vários apps, os IDs podem ser definidos por número de origem.
# Exemplo:
# {"5585999999999":{"PAYMENT_CONFIRMED":"id-1","ORDER_PENDING":"id-2","ORDER_PREPARING":"id-3","ORDER_READY":"id-4","ORDER_OUT_FOR_DELIVERY":"id-5","ORDER_DELIVERED":"id-6","ORDER_CANCELLED":"id-7"}}
GUPSHUP_TEMPLATE_BY_SOURCE_JSON={}

# Parâmetros esperados pelo código:
# PAYMENT_CONFIRMED: nome, método, número do pedido, restaurante, total.
# ORDER_*: nome, número do pedido, restaurante, link seguro (vazio quando não aplicável).

# Compatibilidade legada: deixe vazio quando CUSTOMER_NOTIFICATION_PROVIDER=gupshup.
WHATSAPP_WEBHOOK_URL=
